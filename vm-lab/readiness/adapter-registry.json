        "readiness.kvm_kernel_support",
        "readiness.qemu",
        "readiness.libvirt",
        "readiness.libvirt_service",
        "readiness.virt_install",
        "readiness.graphical_manager",
        "readiness.uefi_firmware",
        "readiness.current_user_access",
        "readiness.cgroup_mode",
        "readiness.conflict_summary"
      ]
    },
    {
      "id": "fedora.storage.vm-capacity-summary",
      "version": "1.0.0",
      "maturity_level": 1,
      "implementation_status": "fixture_validated_parser_only",
      "execution_enabled": false,
      "source_id": "storage.mount-summary",
      "source_interface": "/proc/self/mountinfo normalized without personal paths",
      "parser_id": "storage_readiness_v1",
      "fixture_input": "storage_summary",
      "risk": {"tier": 1, "privilege": false, "network": false, "mutation": false, "device_wake": false},
      "bounds": {"max_input_bytes": 8192, "max_output_results": 2, "attempt_limit": 1},
