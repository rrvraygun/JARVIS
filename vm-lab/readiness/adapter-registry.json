      "risk": {"tier": 1, "privilege": false, "network": false, "mutation": false, "device_wake": false},
      "bounds": {"max_input_bytes": 4096, "max_output_results": 1, "attempt_limit": 1},
      "expected_check_ids": ["readiness.selinux"]
