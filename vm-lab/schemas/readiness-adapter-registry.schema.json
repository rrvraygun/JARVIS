{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fixture-only Fedora L2 readiness adapter registry",
  "type": "object",
  "required": ["schema_version", "registry_id", "version", "implementation_status", "execution_enabled", "host_observation_enabled", "live_backend_implemented", "bindings", "invariants", "fixture_set", "existing_tier0_bindings", "adapters"],
  "properties": {
    "schema_version": {"const": 1},
    "registry_id": {"const": "fedora-l2-readiness-fixture-adapters"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "implementation_status": {"const": "fixture_validated_parsers_only"},
    "execution_enabled": {"const": false},
    "host_observation_enabled": {"const": false},
    "live_backend_implemented": {"const": false},
    "bindings": {"type": "object", "minProperties": 4, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "invariants": {"type": "object"},
    "fixture_set": {
      "type": "object",
      "required": ["id", "synthetic", "represents_host", "files"],
      "properties": {
        "id": {"const": "fedora-kvm-synthetic-v1"},
        "synthetic": {"const": true},
        "represents_host": {"const": false},
        "files": {"type": "object", "minProperties": 3, "additionalProperties": {"type": "string", "pattern": "^fixtures/readiness/[A-Za-z0-9_./-]+$"}}
      },
      "additionalProperties": false
    },
    "existing_tier0_bindings": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object"}},
    "adapters": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "version", "maturity_level", "implementation_status", "execution_enabled", "source_id", "source_interface", "parser_id", "fixture_input", "risk", "bounds", "expected_check_ids"],
        "properties": {
          "id": {"type": "string"},
          "version": {"type": "string"},
          "maturity_level": {"const": 1},
          "implementation_status": {"const": "fixture_validated_parser_only"},
          "execution_enabled": {"const": false},
          "source_id": {"type": "string"},
          "source_interface": {"type": "string"},
          "parser_id": {"enum": ["virtualization_readiness_v1", "storage_readiness_v1", "selinux_readiness_v1"]},
          "fixture_input": {"type": "string"},
          "risk": {"type": "object"},
          "bounds": {"type": "object"},
          "expected_check_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
