{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fedora KVM readiness observation plan",
  "type": "object",
  "required": ["schema_version", "plan_id", "version", "status", "implementation_status", "execution_enabled", "approval_granted", "host_scan_performed", "fixture_adapter_registry_complete", "live_observation_backend_complete", "target", "authority", "checks", "explicit_exclusions", "decision_outcomes", "completion_artifact", "current_blockers", "next_decision"],
  "properties": {
    "schema_version": {"const": 1},
    "plan_id": {"const": "fedora-kvm-readiness-observation"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"const": "prepared_unapproved"},
    "implementation_status": {"const": "fixture_validated_parsers_only"},
    "execution_enabled": {"const": false},
    "approval_granted": {"const": false},
    "host_scan_performed": {"const": false},
    "fixture_adapter_registry_complete": {"const": true},
    "live_observation_backend_complete": {"const": false},
    "target": {"type": "object"},
    "authority": {"type": "object"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source_id", "result_type", "required", "fixture_adapter_id", "live_backend_implemented"],
        "properties": {
          "id": {"type": "string", "pattern": "^readiness\\.[A-Za-z0-9_.-]+$"},
          "source_id": {"type": "string"},
          "result_type": {"type": "string"},
          "required": {"type": "boolean"},
          "fixture_adapter_id": {"type": "string", "minLength": 1},
          "live_backend_implemented": {"const": false}
        },
        "additionalProperties": false
      }
    },
    "explicit_exclusions": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "decision_outcomes": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "completion_artifact": {"type": "object"},
    "current_blockers": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "next_decision": {"const": "fresh_user_authorization_required_before_any_live_readiness_backend_or_host_observation"}
  },
  "additionalProperties": false
}
