{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jarvis scenario-lab run record",
  "type": "object",
  "required": ["schema_version", "run_id", "mode", "matrix_id", "matrix_version", "profile_digest", "image_lock_digest", "domain_digest", "overlay_digest_before", "started_at", "finished_at", "attempt", "result", "unexpected_conditions", "reset_attestation", "evidence_refs"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "mode": {"enum": ["fixture", "future_vm"]},
    "matrix_id": {"type": "string", "minLength": 1},
    "matrix_version": {"type": "string", "minLength": 1},
    "profile_digest": {"type": "string", "pattern": "^(unresolved|[a-f0-9]{64})$"},
    "image_lock_digest": {"type": "string", "pattern": "^(unresolved|[a-f0-9]{64})$"},
    "domain_digest": {"type": "string", "pattern": "^(unresolved|[a-f0-9]{64})$"},
    "overlay_digest_before": {"type": "string", "pattern": "^(not_applicable|[a-f0-9]{64})$"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "attempt": {"const": 1},
    "result": {"enum": ["passed", "failed", "stopped_unexpected", "inconclusive"]},
    "unexpected_conditions": {"type": "array", "items": {"type": "string"}},
    "reset_attestation": {"type": "object"},
    "evidence_refs": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
