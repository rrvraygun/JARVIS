{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fixture-only observation request",
  "type": "object",
  "required": ["schema_version", "request_id", "mode", "execution_enabled", "host_observation_requested", "fixture_set_id", "adapters", "attempt", "parameters", "expires_at", "bindings"],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "minLength": 1},
    "mode": {"const": "fixture_simulation"},
    "execution_enabled": {"const": false},
    "host_observation_requested": {"const": false},
    "fixture_set_id": {"type": "string", "minLength": 1},
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version"],
        "properties": {"id": {"type": "string"}, "version": {"type": "string"}},
        "additionalProperties": false
      }
    },
    "attempt": {"const": 1},
    "parameters": {"type": "object", "maxProperties": 0},
    "expires_at": {"type": "string", "format": "date-time"},
    "bindings": {
      "type": "object",
      "required": ["adapter_registry_sha256", "broker_policy_sha256", "source_catalog_sha256", "proposal_sha256"],
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    }
  },
  "additionalProperties": false
}
