{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fixture-only observation response",
  "type": "object",
  "required": ["schema_version", "request_id", "status", "execution_performed", "host_observed", "effect_occurred", "persistence_performed", "fixture_set_id", "attempts", "candidate_facts", "warnings"],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string"},
    "status": {"const": "fixture_simulated"},
    "execution_performed": {"const": false},
    "host_observed": {"const": false},
    "effect_occurred": {"const": false},
    "persistence_performed": {"const": false},
    "fixture_set_id": {"type": "string"},
    "attempts": {"const": 1},
    "candidate_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fact_id", "value", "source_id", "synthetic"],
        "properties": {
          "fact_id": {"type": "string"},
          "value": {"type": ["string", "integer", "boolean"]},
          "source_id": {"type": "string"},
          "synthetic": {"const": true}
        },
        "additionalProperties": false
      }
    },
    "warnings": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
