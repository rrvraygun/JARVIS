{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jarvis Fedora workstation-enrollment proposal",
  "type": "object",
  "required": ["schema_version", "proposal_id", "version", "status", "execution_enabled", "approval_granted", "host_scan_performed", "host_binding", "source_catalog_binding", "target", "authority_model", "observation_invariants", "source_priority_for_interpretation", "global_exclusions", "groups", "completion_artifacts", "completion_gate"],
  "properties": {
    "schema_version": {"const": 1},
    "proposal_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"const": "prepared_unapproved"},
    "execution_enabled": {"const": false},
    "approval_granted": {"const": false},
    "host_scan_performed": {"const": false},
    "host_binding": {"type": "null"},
    "source_catalog_binding": {
      "type": "object",
      "required": ["catalog_id", "version", "sha256"],
      "properties": {
        "catalog_id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "target": {"type": "object"},
    "authority_model": {"type": "object"},
    "observation_invariants": {"type": "object"},
    "source_priority_for_interpretation": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "global_exclusions": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "phase", "title", "purpose", "tier", "future_admission", "current_enabled", "privacy", "potential_effect", "source_ids", "facts", "maximum_records", "output_limit_bytes", "freshness_seconds", "normalized_retention", "raw_retention"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "phase": {"enum": ["L1", "L2", "incident_only"]},
          "title": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1},
          "tier": {"type": "integer", "minimum": 0, "maximum": 2},
          "future_admission": {"type": "string", "minLength": 1},
          "current_enabled": {"const": false},
          "privacy": {"enum": ["public", "internal", "restricted"]},
          "potential_effect": {"enum": ["none", "none_expected", "protected_or_may_wake_device"]},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "facts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "type", "source_id", "required", "transform"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "type": {"type": "string", "minLength": 1},
                "source_id": {"type": "string", "minLength": 1},
                "required": {"type": "boolean"},
                "transform": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "maximum_records": {"type": "integer", "minimum": 1},
          "output_limit_bytes": {"type": "integer", "minimum": 1},
          "freshness_seconds": {"type": "integer", "minimum": 1},
          "normalized_retention": {"type": "string", "minLength": 1},
          "raw_retention": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "completion_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "completion_gate": {"type": "object"}
  },
  "additionalProperties": false
}
