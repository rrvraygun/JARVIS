{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jarvis future VM-controller state machine",
  "type": "object",
  "required": ["schema_version", "state_machine_id", "version", "execution_enabled", "initial_state", "states", "terminal_states", "global_stop_conditions", "failure_rules"],
  "properties": {
    "schema_version": {"const": 1},
    "state_machine_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "execution_enabled": {"const": false},
    "initial_state": {"type": "string", "minLength": 1},
    "states": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "terminal_states": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "global_stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "failure_rules": {"type": "object"}
  },
  "additionalProperties": false
}
