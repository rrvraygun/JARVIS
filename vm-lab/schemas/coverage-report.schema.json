{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jarvis fixture coverage report",
  "type": "object",
  "required": ["schema_version", "mode", "matrices", "curated_scenarios", "promotion_ceiling", "physical_gaps_open"],
  "properties": {
    "schema_version": {"const": 1},
    "mode": {"const": "fixture_only"},
    "matrices": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "curated_scenarios": {"type": "object"},
    "promotion_ceiling": {"const": 1},
    "physical_gaps_open": {"type": "integer", "minimum": 1}
  },
  "additionalProperties": false
}
