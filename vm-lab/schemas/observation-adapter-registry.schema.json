{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fixture-only Fedora Tier-0 observation adapter registry",
  "type": "object",
  "required": ["schema_version", "registry_id", "version", "implementation_status", "execution_enabled", "host_observation_enabled", "source_catalog_binding", "proposal_binding", "invariants", "fixture_sets", "adapters"],
  "properties": {
    "schema_version": {"const": 1},
    "registry_id": {"const": "fedora-tier0-observation-adapters"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "implementation_status": {"enum": ["fixture_validated_parsers_only", "tier0_live_read_enabled"]},
    "execution_enabled": {"const": false},
    "host_observation_enabled": {"type": "boolean"},
    "source_catalog_binding": {"$ref": "#/$defs/binding"},
    "proposal_binding": {"$ref": "#/$defs/binding"},
    "invariants": {"type": "object"},
    "fixture_sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "synthetic", "represents_host", "files"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "synthetic": {"const": true},
          "represents_host": {"const": false},
          "files": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^fixtures/observations/"}}
        },
        "additionalProperties": false
      }
    },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version", "maturity_level", "implementation_status", "execution_enabled", "source_id", "source_interface", "parser_id", "fixture_inputs", "risk", "bounds", "expected_fact_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "maturity_level": {"const": 1},
          "implementation_status": {"const": "fixture_validated_parser_only"},
          "execution_enabled": {"const": false},
          "source_id": {"type": "string", "minLength": 1},
          "source_interface": {"type": "string", "minLength": 1},
          "parser_id": {"enum": ["os_release_v1", "kernel_identity_v1", "cpu_summary_v1", "memory_summary_v1"]},
          "fixture_inputs": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "risk": {
            "type": "object",
            "required": ["tier", "privilege", "network", "mutation", "device_wake"],
            "properties": {
              "tier": {"const": 0},
              "privilege": {"const": false},
              "network": {"const": false},
              "mutation": {"const": false},
              "device_wake": {"const": false}
            },
            "additionalProperties": false
          },
          "bounds": {
            "type": "object",
            "required": ["max_input_bytes", "max_output_facts", "attempt_limit"],
            "properties": {
              "max_input_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
              "max_output_facts": {"type": "integer", "minimum": 1, "maximum": 64},
              "attempt_limit": {"const": 1}
            },
            "additionalProperties": false
          },
          "expected_fact_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "required": ["version", "sha256"],
      "properties": {
        "catalog_id": {"type": "string"},
        "proposal_id": {"type": "string"},
        "version": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "anyOf": [
    {
      "properties": {
        "implementation_status": {"const": "fixture_validated_parsers_only"},
        "host_observation_enabled": {"const": false}
      }
    },
    {
      "properties": {
        "implementation_status": {"const": "tier0_live_read_enabled"},
        "host_observation_enabled": {"const": true},
        "execution_enabled": {"const": false}
      }
    }
  ]
}
