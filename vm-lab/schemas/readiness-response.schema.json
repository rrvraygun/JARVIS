{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fixture-only Fedora L2 readiness response",
  "type": "object",
  "required": ["schema_version", "status", "fixture_set_id", "execution_performed", "host_observed", "effect_occurred", "persistence_performed", "attempts", "candidate_results", "warnings"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"const": "fixture_simulated"},
    "fixture_set_id": {"const": "fedora-kvm-synthetic-v1"},
    "execution_performed": {"const": false},
    "host_observed": {"const": false},
    "effect_occurred": {"const": false},
    "persistence_performed": {"const": false},
    "attempts": {"const": 1},
    "candidate_results": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "type": "object",
        "required": ["check_id", "result", "source_id", "synthetic"],
        "properties": {
          "check_id": {"type": "string"},
          "result": {"type": ["string", "object"]},
          "source_id": {"type": "string"},
          "synthetic": {"const": true}
        },
        "additionalProperties": false
      }
    },
    "warnings": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
