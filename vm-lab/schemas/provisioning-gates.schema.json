{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fedora Workstation VM provisioning gates",
  "type": "object",
  "required": ["schema_version", "gate_set_id", "version", "status", "execution_enabled", "current_gate", "gates"],
  "properties": {
    "schema_version": {"const": 1},
    "gate_set_id": {"const": "fedora-workstation-full-provisioning"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"const": "prepared_not_started"},
    "execution_enabled": {"const": false},
    "current_gate": {"const": "P1_virtualization_readiness_observation"},
    "gates": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "authority", "state_change", "current_status", "entry_requirements", "completion_evidence", "user_action_if_reached", "forbidden_during_gate"],
        "properties": {
          "id": {"type": "string", "pattern": "^P[0-7]_[A-Za-z0-9_]+$"},
          "authority": {"type": "string"},
          "state_change": {"type": "boolean"},
          "current_status": {"enum": ["completed", "next_blocked_on_user_authorization", "blocked"]},
          "entry_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "completion_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "user_action_if_reached": {"type": "string"},
          "forbidden_during_gate": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
