{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jarvis physical-evidence gap catalog",
  "type": "object",
  "required": ["schema_version", "catalog_id", "version", "evidence_rule", "gaps"],
  "properties": {
    "schema_version": {"const": 1},
    "catalog_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "evidence_rule": {"type": "string", "minLength": 1},
    "gaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "claim_blocked", "why_vm_is_insufficient", "required_future_evidence", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "claim_blocked": {"type": "string", "minLength": 1},
          "why_vm_is_insufficient": {"type": "string", "minLength": 1},
          "required_future_evidence": {"type": "string", "minLength": 1},
          "status": {"const": "open"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
