{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jarvis Fedora enrollment source catalog",
  "type": "object",
  "required": ["schema_version", "catalog_id", "version", "implementation_status", "execution_enabled", "sources"],
  "properties": {
    "schema_version": {"const": 1},
    "catalog_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "implementation_status": {"const": "definitions_only"},
    "execution_enabled": {"const": false},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source_class", "interface", "access", "privacy", "potential_effect", "network", "mutation", "future_adapter_required"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "source_class": {"type": "string", "minLength": 1},
          "interface": {"type": "string", "minLength": 1},
          "access": {"enum": ["unprivileged_read", "user_session_read", "protected_read"]},
          "privacy": {"enum": ["public", "internal", "restricted"]},
          "potential_effect": {"enum": ["none", "none_expected", "protected_access", "may_wake_device"]},
          "network": {"const": false},
          "mutation": {"const": false},
          "future_adapter_required": {"const": true}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
