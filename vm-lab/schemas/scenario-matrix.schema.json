{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jarvis fixture scenario matrix",
  "type": "object",
  "required": ["schema_version", "matrix_id", "version", "title", "domain", "execution_enabled", "coverage_strategy", "dimensions", "exclusions", "oracle_rules", "evidence_ceiling", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "matrix_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "title": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "execution_enabled": {"const": false},
    "coverage_strategy": {"const": "exhaustive_declared_state_space"},
    "dimensions": {"type": "object"},
    "context_dimensions": {"type": "object"},
    "exclusions": {"type": "array", "items": {"type": "object"}},
    "oracle_rules": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "evidence_ceiling": {"const": "simulation_only"},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
