{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jarvis pinned fixture-coverage expectation",
  "type": "object",
  "required": ["schema_version", "mode", "curated_scenarios", "physical_gaps_open", "matrices"],
  "properties": {
    "schema_version": {"const": 1},
    "mode": {"const": "fixture_only"},
    "curated_scenarios": {"type": "integer", "minimum": 1},
    "physical_gaps_open": {"type": "integer", "minimum": 1},
    "matrices": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["matrix_id", "version", "evaluated_state_cases", "context_variants", "logical_declared_cases", "declared_pair_values_total", "state_space_digest"],
        "properties": {
          "matrix_id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "evaluated_state_cases": {"type": "integer", "minimum": 1},
          "context_variants": {"type": "integer", "minimum": 1},
          "logical_declared_cases": {"type": "integer", "minimum": 1},
          "declared_pair_values_total": {"type": "integer", "minimum": 1},
          "state_space_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
