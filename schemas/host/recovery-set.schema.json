{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Jarvis Fedora R2 recovery-set plan",
  "type": "object",
  "required": [
    "schema_version",
    "plan_id",
    "version",
    "status",
    "target",
    "repository",
    "consistency_model",
    "boundaries",
    "explicit_exclusions",
    "operations",
    "proof_matrix",
    "stop_conditions",
    "approval_policy",
    "claims"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "plan_id": {"const": "jarvis-fedora-r2-system-set-v1"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"const": "prepared_not_executed"},
    "target": {
      "type": "object",
      "required": ["machine_scope", "operating_system", "host_identity_storage"],
      "properties": {
        "machine_scope": {"const": "single-enrolled-workstation"},
        "operating_system": {"const": "Fedora Workstation"},
        "host_identity_storage": {"const": "pseudonym-only"}
      },
      "additionalProperties": false
    },
    "repository": {"type": "object"},
    "consistency_model": {"type": "object"},
    "boundaries": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "source_alias", "filesystem_class", "capture_method", "included", "excluded", "validation", "restore_scope"],
        "properties": {
          "id": {"enum": ["root", "home", "systemd_machines", "boot", "efi"]},
          "source_alias": {"type": "string"},
          "filesystem_class": {"type": "string"},
          "capture_method": {"enum": ["btrfs_readonly_snapshot", "restic_live_filesystem_capture"]},
          "included": {"type": "array", "minItems": 1},
          "excluded": {"type": "array"},
          "validation": {"type": "array", "minItems": 2},
          "restore_scope": {"type": "array", "minItems": 1}
        },
        "additionalProperties": false
      }
    },
    "explicit_exclusions": {"type": "array", "minItems": 6},
    "operations": {"type": "array", "minItems": 10},
    "proof_matrix": {"type": "array", "minItems": 10},
    "stop_conditions": {"type": "array", "minItems": 10},
    "approval_policy": {"type": "object"},
    "claims": {"type": "object"}
  },
  "additionalProperties": false
}
