<?xml version="1.0" encoding="UTF-8"?>
<policyconfig>
  <action id="org.jarvis.update-control">
    <description>Replay one exact reviewed Jarvis package transaction</description>
    <message>Authenticate this single Jarvis package transaction.</message>
    <defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/jarvis-update-control</annotate>
  </action>
</policyconfig>
