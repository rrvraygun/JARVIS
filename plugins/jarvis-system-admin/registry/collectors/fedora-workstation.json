{
  "schema_version": 1,
  "id": "fedora-readonly-inventory",
  "version": "1.1.0",
  "attempt_limit": 1,
  "timeout_seconds": 15,
  "max_output_bytes": 1048576,
  "collect_sensitive": false,
  "commands": [
    {"id":"kernel","argv":["uname","-rmo"],"fact_key":"system.kernel","parser":"text"},
    {"id":"bash","argv":["bash","--version"],"fact_key":"shell.bash.version","parser":"first-line"},
    {"id":"fedora-release","argv":["rpm","--eval","%fedora"],"fact_key":"os.fedora.release","parser":"text"},
    {"id":"fedora-edition","argv":["rpm","-q","fedora-release-workstation"],"fact_key":"os.fedora.workstation-package","parser":"text","optional":true},
    {"id":"dnf","argv":["rpm","-q","--qf","%{VERSION}-%{RELEASE}\\n","dnf5"],"fact_key":"packages.dnf.version","parser":"text"},
    {"id":"flatpak","argv":["flatpak","--version"],"fact_key":"packages.flatpak.version","parser":"first-line","optional":true},
    {"id":"rpm-ostree","argv":["rpm","-q","--qf","%{VERSION}-%{RELEASE}\\n","rpm-ostree"],"fact_key":"packages.rpm-ostree.version","parser":"text","optional":true},
    {"id":"cpu","argv":["lscpu","--json"],"fact_key":"hardware.cpu","parser":"json"},
    {"id":"memory","argv":["free","--bytes"],"fact_key":"hardware.memory","parser":"text"},
    {"id":"pci","argv":["lspci","-nn"],"fact_key":"hardware.pci","parser":"lines"},
    {"id":"usb","argv":["lsusb"],"fact_key":"hardware.usb","parser":"lines","optional":true},
    {"id":"block-layout","argv":["lsblk","--json","--output","NAME,TYPE,SIZE,FSTYPE,FSVER,MOUNTPOINTS"],"fact_key":"storage.block-layout","parser":"json"},
    {"id":"root-mount","argv":["findmnt","--json","--output","TARGET,SOURCE,FSTYPE,OPTIONS","/"],"fact_key":"storage.root-mount","parser":"json","observation_scope":"Codex sandbox mount namespace; filesystem and source are evidence, options may differ from host"},
    {"id":"systemd","argv":["systemctl","--version"],"fact_key":"services.systemd.version","parser":"first-line"},
    {"id":"virtualization","argv":["systemd-detect-virt"],"fact_key":"observer.execution-environment","parser":"text","success_codes":[0,1],"observation_scope":"Codex command execution environment; not host virtualization state"},
    {"id":"selinux","argv":["getenforce"],"fact_key":"security.selinux.mode","parser":"text","optional":true,"observation_scope":"kernel state visible through Codex sandbox; confirm outside sandbox before security changes"},
    {"id":"secure-boot","argv":["mokutil","--sb-state"],"fact_key":"security.secure-boot","parser":"text","optional":true},
    {"id":"podman","argv":["rpm","-q","--qf","%{VERSION}-%{RELEASE}\\n","podman"],"fact_key":"containers.podman.version","parser":"text","optional":true},
    {"id":"docker","argv":["docker","--version"],"fact_key":"containers.docker.version","parser":"first-line","optional":true},
    {"id":"virsh","argv":["virsh","--version"],"fact_key":"virtualization.libvirt.version","parser":"first-line","optional":true},
    {"id":"qemu","argv":["qemu-system-x86_64","--version"],"fact_key":"virtualization.qemu.version","parser":"first-line","optional":true},
    {"id":"btrfs","argv":["btrfs","version"],"fact_key":"storage.btrfs.tool-version","parser":"first-line","optional":true},
    {"id":"lvm","argv":["rpm","-q","--qf","%{VERSION}-%{RELEASE}\\n","lvm2"],"fact_key":"storage.lvm.tool-version","parser":"text","optional":true},
    {"id":"snapper","argv":["rpm","-q","--qf","%{VERSION}-%{RELEASE}\\n","snapper"],"fact_key":"backup.snapper.version","parser":"text","optional":true}
  ]
}
