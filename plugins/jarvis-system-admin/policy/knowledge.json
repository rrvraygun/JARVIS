{
  "schema_version": 1,
  "attempt_limit": 1,
  "automatic_retry": false,
  "lesson_candidate_success_threshold": 3,
  "lesson_candidate_requires_independent_verification": true,
  "lesson_activation_requires_user": true,
  "lesson_scope": "enrolled-workstation",
